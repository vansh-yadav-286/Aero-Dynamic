# Copy this file to .env. Never commit real credentials.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aero_dynamic?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aero_dynamic?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Scheduled weather ingestion
CRON_SECRET="replace-with-a-separate-random-secret"
OPENWEATHER_API_KEY=""

# AI safety briefing drafts (optional)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional external aviation services
AVIATION_EDGE_API_KEY=""
OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""

# Client-side map tiles (optional)
NEXT_PUBLIC_MAPBOX_TOKEN=""
